{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ADE AGS",
  "version": "1.14.0",
  "identifier": "com.luis.controlcode",
  "build": {
    "beforeDevCommand": "bun scripts/stage-cef-dev.mjs && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build && bun run stage-cli",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ADE AGS",
        "maximized": true,
        "visible": false,
        "width": 1280,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost https://asset.localhost https: http://localhost:* http://127.0.0.1:*",
        "font-src": "'self' data:",
        "media-src": "'self' data: blob: asset: http://asset.localhost https://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "frame-src": "http:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**",
            "/**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "files": {
        "Frameworks/Chromium Embedded Framework.framework": "./cef-bundle-staging/Frameworks/Chromium Embedded Framework.framework",
        "Frameworks/ADE AGS Helper.app": "./cef-bundle-staging/Frameworks/ADE AGS Helper.app",
        "Frameworks/ADE AGS Helper (GPU).app": "./cef-bundle-staging/Frameworks/ADE AGS Helper (GPU).app",
        "Frameworks/ADE AGS Helper (Renderer).app": "./cef-bundle-staging/Frameworks/ADE AGS Helper (Renderer).app",
        "Frameworks/ADE AGS Helper (Plugin).app": "./cef-bundle-staging/Frameworks/ADE AGS Helper (Plugin).app",
        "Frameworks/ADE AGS Helper (Alerts).app": "./cef-bundle-staging/Frameworks/ADE AGS Helper (Alerts).app"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries": "binaries/",
      "infoplist/pt-BR.lproj/InfoPlist.strings": "pt-BR.lproj/InfoPlist.strings",
      "infoplist/en.lproj/InfoPlist.strings": "en.lproj/InfoPlist.strings",
      "infoplist/es.lproj/InfoPlist.strings": "es.lproj/InfoPlist.strings",
      "../skills/ags-orchestrator": "skills/ags-orchestrator/",
      "../skills/jev-sim-use": "skills/jev-sim-use/",
      "../skills/agent-desktop": "skills/agent-desktop/"
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/ags": "binaries/ags"
        }
      },
      "rpm": {
        "files": {
          "/usr/bin/ags": "binaries/ags"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/tonalenar/ADE-AGS/releases/latest/download/latest.json"
      ]
    }
  }
}
